---
// Страница версии (РФ или English): тема, шапка, подвал, плашка режима, запоминание версии, кнопки «Запросить демо».
// Тип бизнеса задан регионом (/ru/ — сеть, /en/ — 1–9 заведений): inline-скрипт в <head> ставит data-segment на <html>
// и window.__vilaxSegment до отрисовки (REGION_SEGMENT[lang]); ?segment= и прежний localStorage.vilax.segment не учитываются,
// vilax.segment перезаписывается значением региона. Комментарии держим здесь (фронтматтер не попадает в HTML):
// в inline-скрипте их быть не должно — иначе кириллица утечёт в /en/ (строгое правило «в /en/ ни одной русской буквы»).
import Base from './Base.astro';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import ModeBadge from '../components/site/ModeBadge.astro';
import DemoForm from '../components/demo-form/DemoForm.astro';
import Analytics from '../components/site/Analytics.astro';
import { ui, type Lang } from '../i18n';
import { VERSION_KEY, SEGMENT_KEY, REGION_SEGMENT } from '../lib/site';
import { typo } from '../lib/typo';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string;
  canonicalPath?: string;
  alternates?: Partial<Record<Lang, string>>;
  /** Страница начинается с обложки: шапка прозрачная поверх неё. */
  overHero?: boolean;
  noindex?: boolean;
  jsonLd?: object[];
}

const { lang, overHero = false, ...rest } = Astro.props;
const t = ui(lang);
---

<Base lang={lang} {...rest}>
  <script is:inline slot="head" define:vars={{ segKey: SEGMENT_KEY, seg: REGION_SEGMENT[lang] }}>
    document.documentElement.dataset.segment = seg;
    window.__vilaxSegment = seg;
    try {
      localStorage.setItem(segKey, seg);
    } catch (e) {}
  </script>
  <a class="skip-link" href="#main">{typo(lang, t.a11y.skip)}</a>
  <Header lang={lang} overHero={overHero} />
  <main id="main" class:list={['page', { 'page--offset': !overHero }]} tabindex="-1">
    <slot />
  </main>
  <DemoForm lang={lang} />
  <Footer lang={lang} />
  <ModeBadge lang={lang} />
  <Analytics lang={lang} />
</Base>

<script is:inline define:vars={{ lang, key: VERSION_KEY }}>
  try {
    localStorage.setItem(key, lang);
  } catch {}
</script>

<script is:inline>
  // Якоря: перед прыжком секции раскладываются по-настоящему (снимается content-visibility, base.css),
  // чтобы цель встала под шапку. Адрес с # при загрузке — сразу.
  (function () {
    var root = document.documentElement;
    var off = function () {
      root.classList.add('cv-off');
    };
    if (location.hash.length > 1) off();
    document.addEventListener(
      'click',
      function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a[href*="#"]') : null;
        // «Запросить демо» при подключённой форме никуда не прыгает — секции не раскрываем (лишние 200+ мс на нажатие)
        if (a && a.hasAttribute('data-demo') && window.__vilaxDemoForm) return;
        if (a && a.pathname === location.pathname && a.hash.length > 1) off();
      },
      true,
    );
    addEventListener('hashchange', off);
  })();
</script>

<script>
  // Контракт для B и C не менялся: тип — window.__vilaxSegment и data-segment на <html> (выставлены в <head> из региона),
  // событие 'vilax:segment' {segment}. Переключателя типа больше нет — событие уходит один раз после загрузки,
  // для подписчиков, которые ждут его вместо чтения начального значения.
  const seg = document.documentElement.dataset.segment;
  window.dispatchEvent(new CustomEvent('vilax:segment', { detail: { segment: seg } }));
</script>

<script>
  // Все «Запросить демо» открывают одну форму (сессия C): событие vilax:demo с секцией, где нажали.
  // Пока форма не подключена (нет window.__vilaxDemoForm), ссылка ведёт к финальному призыву #demo.
  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-demo]');
    if (!trigger || !(window as unknown as { __vilaxDemoForm?: boolean }).__vilaxDemoForm) return;
    e.preventDefault();
    const calc = trigger.dataset.demoCalc ? JSON.parse(trigger.dataset.demoCalc) : null;
    window.dispatchEvent(new CustomEvent('vilax:demo', { detail: { section: trigger.dataset.demo, calc } }));
  });
</script>

<style>
  .page {
    display: block;
    outline: none;
  }
  .page--offset {
    padding-top: var(--header-h);
  }
</style>
