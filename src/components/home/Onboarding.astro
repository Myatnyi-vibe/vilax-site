---
// «Как подключаем» (прототип «Onboarding»): H2, 3D-лента (только ≥ 768), пять шагов, карточка «включено».
import T from '../T.astro';
import { siteOf } from '../../lib/content';
import { tone, VARIANTS } from '../../lib/site';

const steps = siteOf(VARIANTS[0]).onboarding.steps.map((_, i) => i);
const last = steps.length - 1;
---

<section id="onboarding" class="ob sheet pad" {...tone('onboarding')} data-screen-label="Onboarding">
  <div class="wrap ob__out">
    <h2 data-reveal class="h2"><T get={(s) => s.onboarding.title} /></h2>
    <div data-vlx3d="onboarding" aria-hidden="true" class="ob__slot"></div>
    <ol class="ob__steps">
      {
        steps.map((i) => (
          <li data-reveal class:list={['ob__step', { 'ob__step--last': i === last }]}>
            <h3 class="ob__h3">
              <T get={(s) => s.onboarding.steps[i].title} />
            </h3>
            <p class="ob__p">
              <T get={(s) => s.onboarding.steps[i].text} />
            </p>
          </li>
        ))
      }
    </ol>
    <div data-reveal class="ob__inc">
      <h3 class="ob__inch3"><T get={(s) => s.onboarding.included.title} /></h3>
      <p class="ob__incp"><T get={(s) => s.onboarding.included.text} /></p>
    </div>
  </div>
</section>

<style>
  .ob__out {
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 3vw, 40px);
  }
  .ob__slot {
    height: clamp(150px, 15vw, 220px);
    width: 100%;
  }
  @media (max-width: 767.98px) {
    .ob__slot {
      display: none;
    }
  }
  .ob__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(20px, 2vw, 32px);
  }
  @media (max-width: 767.98px) {
    .ob__steps {
      grid-template-columns: 1fr;
    }
  }
  .ob__step {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 20px;
    border-top: 1px solid var(--hairS);
  }
  .ob__step--last {
    border-top: 2px solid var(--accent);
  }
  .ob__h3 {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .ob__p {
    font-size: 15px;
    color: var(--muted);
  }
  .ob__inc {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 12px 48px;
    padding: 28px;
    border-radius: 12px;
    background: var(--surf);
    box-shadow: inset 0 2px 0 var(--accent);
  }
  .ob__inch3 {
    font-size: 20px;
    font-weight: 600;
    line-height: 1.3;
  }
  .ob__incp {
    font-size: 16px;
    color: var(--muted);
  }
</style>
