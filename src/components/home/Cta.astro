---
// Секция 11 «Финальный призыв» (SITE-1, SITE-15): крупная панель, текст и кнопка слева, нити знака VILAX справа —
// обрезаны краем панели, вершина у нижнего края. Нити проявляются один раз от кончиков к вершине, когда панель
// появляется (класс is-in ставит Reveal.astro); без скриптов и при «меньше движения» знак виден сразу целиком.
// Якорь #demo — сюда ведут все «Запросить демо»; кнопка с data-demo открывает форму C (обработчик в Version.astro).
// Тексты — словарь B (cta.json: title, text, button). РФ — панель surface-1, English — тёмная вставка (DESIGN.md → inverse).
import ruCta from '../../content/ru/cta.json';
import enCta from '../../content/en/cta.json';
import { MARK_PATH, MARK_VIEWBOX } from '../brand/logo-paths';
import type { Lang } from '../../i18n';
import SectionHead from './SectionHead.astro';

interface Props {
  lang: Lang;
}

interface CtaCopy {
  title: string;
  text?: string;
  button?: string;
}

const { lang } = Astro.props;
const t = (lang === 'ru' ? ruCta : enCta) as CtaCopy;
// панель тёмная в обеих версиях, поэтому градиент один: Data Cyan → Signal Blue («голубая половина на тёмном»,
// как на экране выбора); синий English-градиент #2297FF → #0B6BCB на #020817 теряется
const grad = ['#18F2DF', '#2297FF'];
---

<section class="sec cta" id="demo" aria-labelledby="demo-title">
  <div class="container">
    <div class="cta__panel" data-reveal>
      <div class="cta__strands" aria-hidden="true">
        {
          (['left', 'right'] as const).map((side) => (
            <svg class={`cta__wing cta__wing--${side}`} viewBox={MARK_VIEWBOX} focusable="false">
              <defs>
                <linearGradient id={`cta-g-${side}`} gradientUnits="userSpaceOnUse" x1="184" y1="0" x2="896" y2="0">
                  <stop offset="0" stop-color={grad[0]} />
                  <stop offset="1" stop-color={grad[1]} />
                </linearGradient>
              </defs>
              <path fill={`url(#cta-g-${side})`} d={MARK_PATH} />
            </svg>
          ))
        }
      </div>
      <div class="cta__body">
        <SectionHead lang={lang} id="demo-title" size="lg" title={t.title} lead={t.text} />
        {t.button && (
          <a class="btn btn--primary cta__btn" href="#demo" data-demo="cta">
            {t.button}
          </a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  /* панель сама отделяет секцию — верхняя граница .sec не нужна */
  .sec.cta {
    border-top: 0;
  }

  .cta__panel {
    /* фон панели — от него же считается подложка под текстом */
    --cta-bg: var(--surface-1);
    /* ширина текстовой колонки и боковой отступ — подложка закрывает ровно колонку текста */
    --cta-text: 560px;
    --cta-pad-x: var(--sp-8);
    /* знак: ширина от панели, вершина (низ середины viewBox) — справа у нижнего края */
    --mark-w: 60%;
    --apex-x: 78%;
    --strand-o: 0.6;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: var(--sp-9) var(--cta-pad-x);
    border: 1px solid var(--hairline);
    border-radius: var(--r-xl);
    background: var(--cta-bg);
    color: var(--ink);
    /* в РФ --shadow: none (без теней на тёмном), в English — одна мягкая navy-тень */
    box-shadow: var(--shadow, none);
  }

  /* English: тёмная вставка на светлой странице. Переменные переопределены внутри панели — заголовок, абзац
     и кнопка берут их сами. Кнопка светлая с тёмным текстом, фокус светлый: акцент #0B6BCB на #020817 не виден. */
  :global([data-theme='en']) .cta__panel {
    --cta-bg: var(--inverse);
    --ink: var(--canvas);
    --ink-muted: #c3ccda;
    --accent: var(--canvas);
    --accent-hover: var(--surface-3);
    --on-accent: var(--inverse);
    --focus: var(--canvas);
    border-color: var(--inverse);
  }

  .cta__strands {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .cta__wing {
    position: absolute;
    left: calc(var(--apex-x) - var(--mark-w) / 2);
    bottom: calc(var(--sp-2) * -1);
    width: var(--mark-w);
    height: auto;
    aspect-ratio: 712 / 608;
    max-width: none;
    opacity: var(--strand-o);
  }
  .cta__wing--left {
    clip-path: inset(0 50% 0 0);
  }
  .cta__wing--right {
    clip-path: inset(0 0 0 50%);
  }
  /* подложка под текстом: нити уходят под неё, у правого края колонки текста не прозрачнее 0.65 —
     контраст абзаца остаётся выше 4,5:1 даже поверх самой яркой нити */
  .cta__strands::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--cta-bg) 94%, transparent) 0,
      color-mix(in srgb, var(--cta-bg) 80%, transparent) calc(var(--cta-pad-x) + var(--cta-text) * 0.7),
      color-mix(in srgb, var(--cta-bg) 65%, transparent) calc(var(--cta-pad-x) + var(--cta-text)),
      color-mix(in srgb, var(--cta-bg) 0%, transparent) calc(var(--cta-pad-x) + var(--cta-text) + 200px)
    );
  }

  @media (prefers-reduced-motion: no-preference) {
    /* проявление от кончиков к вершине: полоса маски сползает сверху вниз (как на обложке), один раз —
       когда Reveal.astro ставит панели is-in. Без .reveal-on (нет скриптов, «меньше движения») правило не действует. */
    :global(.reveal-on) .cta__wing {
      -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 40%, transparent 60%);
      mask-image: linear-gradient(to bottom, #000 0%, #000 40%, transparent 60%);
      -webkit-mask-size: 100% 250%;
      mask-size: 100% 250%;
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      -webkit-mask-position: 0 100%;
      mask-position: 0 100%;
    }
    :global(.reveal-on) .cta__panel.is-in .cta__wing {
      animation: cta-strands-in 1.35s cubic-bezier(0.65, 0, 0.35, 1) 0.25s both;
    }
    :global(.reveal-on) .cta__panel.is-in .cta__wing--right {
      animation-delay: 0.37s;
    }
  }
  @keyframes cta-strands-in {
    from {
      -webkit-mask-position: 0 100%;
      mask-position: 0 100%;
    }
    to {
      -webkit-mask-position: 0 0;
      mask-position: 0 0;
    }
  }

  .cta__body {
    position: relative;
    z-index: 1;
    max-width: var(--cta-text);
  }
  .cta__btn {
    margin-top: var(--sp-6);
  }

  @media (max-width: 767px) {
    .cta__panel {
      --cta-pad-x: var(--sp-5);
      --mark-w: 72%;
      --apex-x: 84%;
      --strand-o: 0.5;
      padding: var(--sp-7) var(--cta-pad-x);
    }
    /* текст во всю ширину поверх нитей: подложка снизу вверх — у вершины под кнопкой нити видны,
       выше кнопки (где абзац) подложка не прозрачнее 0.6 */
    .cta__strands::after {
      background: linear-gradient(
        to top,
        color-mix(in srgb, var(--cta-bg) 15%, transparent) 0,
        color-mix(in srgb, var(--cta-bg) 30%, transparent) var(--sp-7),
        color-mix(in srgb, var(--cta-bg) 60%, transparent) calc(var(--sp-7) + 44px + var(--sp-6)),
        color-mix(in srgb, var(--cta-bg) 85%, transparent) 100%
      );
    }
    .cta__btn {
      width: 100%;
    }
  }

  /* режим высокой контрастности убирает градиенты подложки — нити под текстом мешали бы чтению */
  @media (forced-colors: active) {
    .cta__strands {
      display: none;
    }
  }
</style>
