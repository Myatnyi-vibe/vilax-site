---
// Секция 5 «AI в системе» (SITE-1): что умеет Координатор (слева) и как он отвечает на вопрос про цифры сети (справа).
// Не чат-бот на сайте: без поля ввода, «печатает…» и шапки окна — спокойный пример диалога на демо-данных.
// Под колонками — настоящий снимок пункта, если он есть в сверке (RU: AI-вердикт дня, широкая полоса 1600×278).
// Тексты — словарь B (ai.json: title, lead, items, chat); pending и aura не выводятся (ТЗ, честность контента).
// Снимки — src/data/verification.json → screens[screen][lang].shot, только с результатом ok.
import ruAi from '../../content/ru/ai.json';
import enAi from '../../content/en/ai.json';
import verification from '../../data/verification.json';
import { MARK_PATH, MARK_VIEWBOX } from '../brand/logo-paths';
import { ui } from '../../i18n';
import type { Lang } from '../../i18n';
import { typo } from '../../lib/typo';
import { fill } from '../../lib/pricing-text';
import SectionHead from './SectionHead.astro';
import Screen from './Screen.astro';

interface Props {
  lang: Lang;
}

interface AiItem {
  screen: string;
  verified?: string;
  title: string;
  text: string;
}
interface AiMessage {
  from: string;
  text: string;
}
interface AiCopy {
  title: string;
  lead?: string;
  items?: AiItem[];
  chat?: { label?: string; messages?: AiMessage[] };
}
interface Check {
  result?: string;
  shot?: string | null;
}

const { lang } = Astro.props;
const t = (lang === 'ru' ? ruAi : enAi) as AiCopy;
const h = ui(lang).home;
const grad = lang === 'en' ? ['#2297FF', '#0B6BCB'] : ['#18F2DF', '#2297FF'];

const items = t.items ?? [];
const chat = t.chat ?? {};
const messages = (chat.messages ?? []).filter((m) => m.from === 'user' || m.from === 'bot');
const hasList = items.length > 0;
const hasChat = messages.length > 0;

// снимок пункта — только проверенный на стейдже (result ok) и снятый для этой версии
const screens = verification.screens as Record<string, Partial<Record<Lang, Check>>>;
const shots = items.flatMap((it) => {
  const c = screens[it.screen]?.[lang];
  return c?.result === 'ok' && c.shot ? [{ ...it, src: c.shot }] : [];
});


// очередь появления: пункты слева через 80 мс, в диалоге — вопрос, затем ответ через 160 мс
const itemDelay = (i: number) => `--reveal-delay: ${i * 80}ms`;
const msgDelay = (i: number) => `--reveal-delay: ${120 + i * 160}ms`;
---

<section class="sec ai" id="ai" aria-labelledby="ai-title">
  <div class="container">
    <SectionHead lang={lang} id="ai-title" title={t.title} lead={t.lead} />

    {
      (hasList || hasChat) && (
        <div class:list={['ai__body', { 'ai__body--split': hasList && hasChat }]}>
          {hasList && (
            <ul class="ai__list" role="list">
              {items.map((it, i) => (
                <li class="ai__item" data-screen={it.screen} data-reveal style={itemDelay(i)}>
                  <h3 class="ai__item-title">{typo(lang, it.title)}</h3>
                  <p class="ai__item-text">{typo(lang, it.text)}</p>
                </li>
              ))}
            </ul>
          )}

          {hasChat && (
            <figure class="ai__chat">
              {chat.label && <figcaption class="ai__label">{typo(lang, chat.label)}</figcaption>}
              <ol class="ai__msgs" role="list">
                {messages.map((m, i) =>
                  m.from === 'user' ? (
                    <li class="ai__msg ai__msg--user" data-reveal style={msgDelay(i)}>
                      <span class="visually-hidden">{h.speakerUser}: </span>
                      {typo(lang, m.text)}
                    </li>
                  ) : (
                    <li class="ai__msg ai__msg--bot" data-reveal style={msgDelay(i)}>
                      <p class="ai__who">
                        <svg
                          class="ai__mark"
                          viewBox={MARK_VIEWBOX}
                          width="20"
                          height="17"
                          aria-hidden="true"
                          focusable="false"
                        >
                          <defs>
                            <linearGradient
                              id={`ai-mark-g-${i}`}
                              gradientUnits="userSpaceOnUse"
                              x1="184"
                              y1="0"
                              x2="896"
                              y2="0"
                            >
                              <stop offset="0" stop-color={grad[0]} />
                              <stop offset="1" stop-color={grad[1]} />
                            </linearGradient>
                          </defs>
                          <path fill={`url(#ai-mark-g-${i})`} d={MARK_PATH} />
                        </svg>
                        <span>{h.speakerBot}</span>
                      </p>
                      <p class="ai__answer">{typo(lang, m.text)}</p>
                    </li>
                  ),
                )}
              </ol>
            </figure>
          )}
        </div>
      )
    }

    {
      shots.map((s) => (
        <div class="ai__shot">
          <Screen
            lang={lang}
            src={s.src}
            alt={fill(h.shotAlt, { title: s.title })}
            screen={s.screen}
            verified={s.verified}
            width={1600}
            height={278}
          />
        </div>
      ))
    }
  </div>
</section>

<script>
  // полоса, которую на телефоне листают вбок, получает фокус с клавиатуры (только когда её действительно листают)
  const frames = document.querySelectorAll<HTMLElement>('.ai__shot .scr__frame');
  const sync = () =>
    frames.forEach((f) => {
      const alt = f.querySelector('img')?.getAttribute('alt') || '';
      if (f.scrollWidth > f.clientWidth + 1) {
        f.setAttribute('tabindex', '0');
        f.setAttribute('role', 'region');
        f.setAttribute('aria-label', alt);
      } else {
        f.removeAttribute('tabindex');
        f.removeAttribute('role');
        f.removeAttribute('aria-label');
      }
    });
  sync();
  let raf = 0;
  addEventListener(
    'resize',
    () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(sync);
    },
    { passive: true },
  );
</script>

<style>
  .ai__body {
    margin-top: var(--sp-7);
    display: grid;
    gap: var(--sp-7);
  }
  /* одна колонка (нет списка или диалога) — не растягиваем на всю ширину */
  .ai__body:not(.ai__body--split) > * {
    max-width: 760px;
  }
  /* компьютер: 5 колонок возможностей и 7 колонок диалога по сетке 12 × 24 px */
  @media (min-width: 768px) {
    .ai__body--split {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--sp-5);
      align-items: start;
    }
    .ai__body--split .ai__list {
      grid-column: 1 / span 5;
      padding-inline-end: var(--sp-5);
    }
    .ai__body--split .ai__chat {
      grid-column: 6 / -1;
    }
  }
  @media (min-width: 1024px) {
    .ai__body--split .ai__list {
      padding-inline-end: var(--sp-7);
    }
  }

  /* возможности: строки между тонкими линиями, верхняя линия стоит вровень с верхом панели диалога */
  .ai__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--hairline);
  }
  .ai__item {
    display: grid;
    gap: var(--sp-2);
    padding-block: var(--sp-5);
    border-top: 1px solid var(--hairline);
  }
  .ai__item-title {
    font-size: var(--fs-title);
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .ai__item-text {
    max-width: 52ch;
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  /* диалог: одна панель на ступень выше фона; на светлой теме — единственная мягкая тень (--shadow), на тёмной её нет */
  .ai__chat {
    margin: 0;
    min-width: 0;
    display: grid;
    gap: var(--sp-5);
    padding: var(--sp-6);
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    background: var(--surface-1);
    box-shadow: var(--shadow, none);
  }
  .ai__label {
    font-size: var(--fs-caption);
    line-height: 1.4;
    color: var(--ink-subtle);
  }
  .ai__msgs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-5);
  }
  .ai__msg {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  /* вопрос — справа, пузырь на верхней ступени с острым углом к говорящему */
  .ai__msg--user {
    position: relative;
    justify-self: end;
    max-width: min(88%, 44ch);
    padding: var(--sp-3) var(--sp-4);
    border-radius: 16px 16px var(--r-xs) 16px;
    background: var(--surface-3);
    color: var(--ink);
    line-height: 1.5;
    text-wrap: pretty;
  }
  /* ответ — слева, без пузыря: знак и имя, текст под именем */
  .ai__msg--bot {
    justify-self: stretch;
  }
  .ai__who {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--fs-caption);
    line-height: 1.4;
    font-weight: 500;
    color: var(--ink-subtle);
  }
  .ai__mark {
    flex: none;
    width: 20px;
    height: auto;
  }
  .ai__answer {
    margin-top: var(--sp-2);
    padding-inline-start: calc(20px + var(--sp-2));
    max-width: calc(60ch + 20px + var(--sp-2));
    color: var(--ink);
    line-height: 1.6;
    text-wrap: pretty;
  }

  /* снимок пункта — полоса на всю ширину контейнера */
  .ai__shot {
    margin-top: var(--sp-8);
  }

  @media (max-width: 767px) {
    .ai__chat {
      padding: var(--sp-5) var(--sp-4);
    }
    .ai__shot {
      margin-top: var(--sp-7);
    }
    /* полоса 1600×278 на телефоне целиком нечитаема — показываем её в читаемом размере и листаем вбок, без обрезки */
    .ai__shot :global(.scr__frame) {
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: thin;
    }
    .ai__shot :global(.scr__img) {
      width: 680px;
      max-width: none;
    }
  }
</style>
