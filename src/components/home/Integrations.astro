---
// Секция 6 «Интеграции» (SITE-1): спецификация, а не витрина логотипов — таблица-сетка названий и видов.
// Слева заголовок, справа работающие интеграции; «в плане» — отдельной группой ниже, пунктиром и приглушённо.
// Тексты — словарь B (integrations.json: title, lead, plannedLabel, items). Логотипов и иконок нет, ничего не нажимается.
import ruIntegrations from '../../content/ru/integrations.json';
import enIntegrations from '../../content/en/integrations.json';
import SectionHead from './SectionHead.astro';
import { typo } from '../../lib/typo';
import type { Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

interface IntegrationItem {
  name: string;
  kind: string;
  screen?: string;
  planned?: boolean;
}

interface IntegrationsCopy {
  title: string;
  lead?: string;
  plannedLabel?: string;
  items?: IntegrationItem[];
}

const { lang } = Astro.props;
const t = (lang === 'ru' ? ruIntegrations : enIntegrations) as IntegrationsCopy;
const items = t.items ?? [];
const live = items.filter((it) => !it.planned);
// «в плане» без подписи группы не выводим: иначе планы читались бы как работающие
const planned = t.plannedLabel ? items.filter((it) => it.planned) : [];
---

<section class="sec integrations" id="integrations" aria-labelledby="integrations-title">
  <div class="container int">
    <div class="int__head">
      <SectionHead lang={lang} id="integrations-title" title={t.title} lead={t.lead} />
    </div>
    <div class="int__body">
      {
        live.length > 0 && (
          <ul class="int__grid" role="list" data-reveal>
            {live.map((it) => (
              <li class="int__cell">
                <p class="int__name" translate="no">{typo(lang, it.name)}</p>
                <p class="int__kind">{typo(lang, it.kind)}</p>
              </li>
            ))}
          </ul>
        )
      }
      {
        planned.length > 0 && (
          <div class="int__planned" data-reveal style="--reveal-delay: 80ms">
            <h3 class="int__label" id="integrations-planned-title">
              {typo(lang, t.plannedLabel ?? '')}
            </h3>
            <ul class="int__grid int__grid--planned" role="list" aria-labelledby="integrations-planned-title">
              {planned.map((it) => (
                <li class="int__cell">
                  <p class="int__name" translate="no">{typo(lang, it.name)}</p>
                  <p class="int__kind">{typo(lang, it.kind)}</p>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  /* раскладка: на телефоне и планшете заголовок над сеткой, с 1024 px — 5 колонок заголовка и 7 колонок сетки */
  .int {
    display: grid;
    gap: var(--sp-7);
  }
  .int__head,
  .int__body {
    min-width: 0;
  }
  @media (min-width: 1024px) {
    .int {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--sp-5);
      align-items: start;
    }
    .int__head {
      grid-column: 1 / span 5;
    }
    .int__body {
      grid-column: 6 / -1;
    }
  }

  /* сетка как таблица без боковых стенок: общие линии между ячейками, внешние верх и низ — на ступень плотнее */
  .int__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--hairline-strong);
  }
  .int__cell {
    min-width: 0;
    display: grid;
    align-content: start;
    gap: var(--sp-1);
    padding: var(--sp-5) var(--sp-5) var(--sp-5) 0;
    border-top: 1px solid var(--hairline);
  }
  .int__cell:nth-child(-n + 2) {
    border-top-color: var(--hairline-strong);
  }
  /* правая колонка: линия слева, текст отступает от неё так же, как левый от неё справа */
  .int__cell:nth-child(even) {
    padding-left: var(--sp-5);
    padding-right: 0;
    border-left: 1px solid var(--hairline);
  }

  .int__name {
    font-size: var(--fs-title);
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .int__kind {
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--ink-subtle);
    text-wrap: pretty;
  }
  .int__ref {
    margin-top: var(--sp-1);
    font-size: var(--fs-caption);
    line-height: 1.4;
    color: var(--ink-faint);
  }

  /* «в плане»: та же сетка, но пунктир и приглушённые названия — видно, что это ещё не работает */
  .int__grid + .int__planned {
    margin-top: var(--sp-7);
  }
  .int__label {
    margin-bottom: var(--sp-3);
    font-size: var(--fs-caption);
    line-height: 1.4;
    font-weight: 500;
    color: var(--ink-subtle);
  }
  .int__grid--planned {
    border-bottom-style: dashed;
  }
  .int__grid--planned .int__cell {
    border-top-style: dashed;
    border-top-color: var(--hairline-strong);
  }
  .int__grid--planned .int__cell:nth-child(even) {
    border-left-style: dashed;
    border-left-color: var(--hairline-strong);
  }
  .int__grid--planned .int__name {
    color: var(--ink-subtle);
  }
  .int__grid--planned .int__kind {
    color: var(--ink-faint);
  }

  @media (max-width: 767px) {
    .int {
      gap: var(--sp-6);
    }
    .int__cell {
      padding-block: var(--sp-4);
      padding-right: var(--sp-4);
    }
    .int__cell:nth-child(even) {
      padding-left: var(--sp-4);
      padding-right: 0;
    }
    .int__grid + .int__planned {
      margin-top: var(--sp-6);
    }
  }
  /* уже 360 px двум колонкам тесно (длинные названия вылезли бы из ячейки) — одна колонка */
  @media (max-width: 359px) {
    .int__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .int__cell,
    .int__cell:nth-child(even) {
      padding-inline: 0;
      border-left: 0;
    }
    .int__cell:nth-child(2) {
      border-top-color: var(--hairline);
    }
  }
</style>
