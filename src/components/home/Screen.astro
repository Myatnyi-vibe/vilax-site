---
// Экран системы: снимок демо в рамке rounded.lg (DESIGN.md → «Экран системы»). Только настоящие снимки со стейджа
// (public/shots, сессия B), никаких интерфейсов из div. В local под рамкой — номер экрана реестра и дата проверки.
import { MODE } from '../../lib/mode';
import { url } from '../../lib/site';
import { ui, type Lang } from '../../i18n';
import { typo } from '../../lib/typo';

interface Props {
  lang: Lang;
  src: string;
  alt: string;
  /** Номер записи реестра v16 (t014, y007…). */
  screen?: string;
  /** Дата проверки на стейдже, ГГГГ-ММ-ДД. */
  verified?: string;
  width?: number;
  height?: number;
  /** Первый экран секции, видимый без действий — 'eager' только если он близко к первому экрану. */
  loading?: 'lazy' | 'eager';
  class?: string;
  /** Атрибуты для скриптов секции (подмена снимка и т. п.). */
  imgId?: string;
}

const {
  lang,
  src,
  alt,
  screen,
  verified,
  width = 1600,
  height = 1000,
  loading = 'lazy',
  class: cls,
  imgId,
} = Astro.props;
const t = ui(lang).home;
const showRef = MODE === 'local' && !!screen;
---

<figure class:list={['scr', cls]}>
  <div class="scr__frame">
    <img class="scr__img" id={imgId} src={url(src)} alt={alt} width={width} height={height} loading={loading} decoding="async" />
  </div>
  {
    showRef && (
      <figcaption class="scr__ref" data-screen-ref>
        <span data-ref-screen>{screen}</span>
        {verified && typo(lang, ` · ${t.verified} ${verified}`)}
      </figcaption>
    )
  }
</figure>

<style>
  .scr {
    margin: 0;
    min-width: 0;
  }
  /* рамка: внешняя граница + внутренний отступ на ступень светлее — снимок «лежит» в панели, как экраны у Linear */
  .scr__frame {
    padding: 6px;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--r-lg);
    background: var(--surface-2);
  }
  :global([data-theme='en']) .scr__frame {
    background: var(--surface-1);
    box-shadow:
      0 1px 2px rgb(2 8 23 / 0.04),
      0 12px 32px rgb(2 8 23 / 0.06);
  }
  .scr__img {
    width: 100%;
    height: auto;
    border-radius: calc(var(--r-lg) - 6px);
    background: #ffffff;
  }
  .scr__ref {
    margin-top: var(--sp-2);
    font-size: var(--fs-caption);
    color: var(--ink-faint);
  }
</style>
