---
// Форма «Запросить демо» (SITE-15, владелец — сессия C): одно окно на страницу версии; на телефоне — шторка снизу.
// Открывает её событие window 'vilax:demo' {section, calc} — его шлют все кнопки с data-demo (src/layouts/Version.astro).
// Четыре поля и отдельная галочка согласия; скрытые поля — версия сайта, регион, секция, страница, UTM, выбор
// калькулятора, версия текста согласия, номер заявки, ловушка для ботов, время заполнения.
// Режимы сборки: local — в стенд трекера (8890), preview — ничего не отправляет, prod — адрес из PUBLIC_VILAX_LEAD_URL.
// Все тексты — из src/content/{ru,en}/legal/form.json: в скрипте нет ни одной строки на языке версии.
import ruForm from '../../content/ru/legal/form.json';
import enForm from '../../content/en/legal/form.json';
import { MODE } from '../../lib/mode';
import { DEFAULT_COUNTRY, leadUrl, type Country } from '../../lib/lead';
import { legalPath } from '../../lib/site';
import { typo } from '../../lib/typo';
import type { Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const f = lang === 'ru' ? ruForm : enForm;
const tp = (s: string) => typo(lang, s);
const url = leadUrl(MODE, import.meta.env.PUBLIC_VILAX_LEAD_URL);
const country: Country = DEFAULT_COUNTRY[lang];
const countries = ['7', '971', 'other'] as const;
// Отдельная страница согласия появляется у сессии A (/ru/consent, /en/consent); пока её нет — ссылка на политику версии.
const pages = import.meta.glob('../../pages/**/consent.astro');
const consentHref = legalPath(lang, pages[`../../pages/${lang}/consent.astro`] ? 'consent' : 'privacy');
const privacyHref = legalPath(lang, 'privacy');
const contacts = f.contacts.filter((c) => c.href);
const textFields = [
  { id: 'name', auto: 'name', min: 2, max: 120, list: null },
  { id: 'city', auto: 'address-level2', min: 2, max: 80, list: 'lead-cities' },
  { id: 'venue', auto: 'organization', min: 2, max: 160, list: null },
] as const;
---

<dialog
  class="lead"
  data-lead
  aria-labelledby="lead-title"
  data-mode={MODE}
  data-url={url ?? ''}
  data-site={lang}
  data-consent-version={f.consentVersion}
>
  <div class="lead__sheet">
    <div class="lead__head">
      <h2 class="lead__title" id="lead-title">{f.title}</h2>
      <button class="lead__close" type="button" data-lead-close aria-label={f.close}>
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
      </button>
    </div>

    <div data-lead-view="form">
      <p class="lead__intro">{tp(f.lead)}</p>
      <form class="lead__form" novalidate data-lead-form>
        <div class="lead__field">
          <label class="lead__label" for="lead-phone">{f.fields.phone.label}</label>
          <div class="lead__phone">
            <select class="lead__input lead__country" id="lead-country" name="country" autocomplete="tel-country-code" aria-label={f.country.label}>
              {countries.map((c) => <option value={c} selected={c === country}>{f.country.options[c]}</option>)}
            </select>
            <input
              class="lead__input"
              id="lead-phone"
              name="phone"
              type="tel"
              inputmode="tel"
              autocomplete="tel-national"
              maxlength="24"
              required
              aria-describedby="lead-phone-err"
              placeholder={f.fields.phone.placeholder[country]}
              data-placeholder-7={f.fields.phone.placeholder['7']}
              data-placeholder-971={f.fields.phone.placeholder['971']}
              data-placeholder-other={f.fields.phone.placeholder.other}
            />
          </div>
          <p class="lead__err" id="lead-phone-err" data-err-for="phone" data-required={f.fields.phone.required} data-invalid={tp(f.fields.phone.invalid)} hidden></p>
        </div>

        {
          textFields.map((x) => (
            <div class="lead__field">
              <label class="lead__label" for={`lead-${x.id}`}>{f.fields[x.id].label}</label>
              <input
                class="lead__input"
                id={`lead-${x.id}`}
                name={x.id}
                type="text"
                autocomplete={x.auto}
                minlength={x.min}
                maxlength={x.max}
                required
                list={x.list ?? undefined}
                aria-describedby={`lead-${x.id}-err`}
                placeholder={f.fields[x.id].placeholder}
              />
              <p class="lead__err" id={`lead-${x.id}-err`} data-err-for={x.id} data-required={f.fields[x.id].required} data-invalid={tp(f.fields[x.id].invalid)} hidden />
            </div>
          ))
        }
        <datalist id="lead-cities">
          {f.cities.map((c) => <option value={c} />)}
        </datalist>

        <!-- Ловушка для ботов: людям не видна и не достаётся с клавиатуры; заполнена — заявка «принята» без записи. -->
        <div class="lead__hp" aria-hidden="true">
          <label for="lead-website">Website</label>
          <input id="lead-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="lead__field">
          <label class="lead__consent" id="lead-consent-label">
            <input id="lead-consent" name="consent" type="checkbox" required aria-describedby="lead-consent-err" />
            <span>
              {tp(f.consent.before)}<a href={consentHref} target="_blank" rel="noopener">{tp(f.consent.consentLink)}<span class="visually-hidden"> {f.consent.newTab}</span></a>{tp(f.consent.between)}<a href={privacyHref} target="_blank" rel="noopener">{tp(f.consent.policyLink)}<span class="visually-hidden"> {f.consent.newTab}</span></a>{f.consent.after}
            </span>
          </label>
          <p class="lead__err" id="lead-consent-err" data-err-for="consent" data-required={tp(f.consent.required)} data-invalid={tp(f.consent.required)} hidden></p>
        </div>

        <div class="lead__failure" role="alert" data-lead-failure hidden>
          <p data-failure-text data-failed={tp(f.failure.failed)} data-unavailable={tp(f.failure.unavailable)} data-limited={tp(f.failure.limited)} data-invalid={tp(f.failure.invalid)}></p>
          {
            contacts.length > 0 && (
              <p class="lead__contacts">
                <span>{f.failure.contacts}:</span>
                {contacts.map((c) => <a href={c.href} rel="noopener">{c.label}</a>)}
              </p>
            )
          }
        </div>

        <button class="btn btn--primary lead__submit" type="submit" aria-describedby="lead-consent-label" data-lead-submit data-idle={f.submit} data-retry={f.failure.retry} data-sending={f.sending}>
          <span class="lead__spinner" aria-hidden="true"></span>
          <span data-label>{f.submit}</span>
        </button>
      </form>
    </div>

    <div class="lead__done" data-lead-view="done" role="status" hidden>
      <p class="lead__done-title" tabindex="-1" data-done-focus>{f.success.title}</p>
      <p>{tp(f.success.text)}</p>
      <button class="btn btn--secondary" type="button" data-lead-close>{f.success.done}</button>
    </div>

    <div class="lead__done" data-lead-view="preview" role="status" hidden>
      <p class="lead__done-title" tabindex="-1" data-done-focus>{f.preview.title}</p>
      <p>{tp(f.preview.text)}</p>
      <button class="btn btn--secondary" type="button" data-lead-close>{f.success.done}</button>
    </div>
  </div>
</dialog>

<script>
  import {
    MIN_FILL_MS, calcOf, checkInput, formatPhone, leadBody, newRequestRef, outcomeOf, pageOf, pickSegment, sectionOf, utmOf,
    type Country, type LeadErrors, type LeadField, type LeadInput, type LeadSegment, type LeadSite,
  } from '../../lib/lead';

  // Форма одна на страницу. Кнопки «Запросить демо» шлют vilax:demo, только когда этот флаг стоит (Version.astro).
  const dialog = document.querySelector<HTMLDialogElement>('dialog[data-lead]');
  if (dialog) setup(dialog);

  function setup(dlg: HTMLDialogElement): void {
    const q = <T extends Element>(sel: string): T => dlg.querySelector<T>(sel)!;
    const form = q<HTMLFormElement>('[data-lead-form]');
    const site = dlg.dataset.site as LeadSite;
    const mode = dlg.dataset.mode ?? 'local';
    const url = dlg.dataset.url || null;
    const country = q<HTMLSelectElement>('[name=country]');
    const inputs = {
      phone: q<HTMLInputElement>('[name=phone]'),
      name: q<HTMLInputElement>('[name=name]'),
      city: q<HTMLInputElement>('[name=city]'),
      venue: q<HTMLInputElement>('[name=venue]'),
    };
    const consent = q<HTMLInputElement>('[name=consent]');
    const honeypot = q<HTMLInputElement>('[name=website]');
    const submit = q<HTMLButtonElement>('[data-lead-submit]');
    const label = submit.querySelector<HTMLElement>('[data-label]')!;
    const failure = q<HTMLElement>('[data-lead-failure]');
    const failureText = q<HTMLElement>('[data-failure-text]');
    const views = [...dlg.querySelectorAll<HTMLElement>('[data-lead-view]')];

    const DRAFT = 'vilax.lead.draft';
    const UTM = 'vilax.lead.utm';
    let opener: Element | null = null;
    let section: string | null = null;
    let calc: Record<string, unknown> | null = null;
    let ref = '';
    let openedAt = 0;
    let sending = false;

    // UTM — с посадочной страницы вкладки: переход на политику и обратно метки не теряет.
    let utm = utmOf(location.search);
    try {
      if (utm) sessionStorage.setItem(UTM, JSON.stringify(utm));
      else utm = JSON.parse(sessionStorage.getItem(UTM) ?? 'null');
    } catch {
      /* хранилище недоступно — метки только с этой страницы */
    }

    const show = (name: string): void => {
      for (const v of views) v.hidden = v.dataset.leadView !== name;
    };
    const fieldOf = (f: LeadField): HTMLInputElement => (f === 'consent' ? consent : inputs[f]);
    const showErrors = (e: LeadErrors): void => {
      for (const f of ['phone', 'name', 'city', 'venue', 'consent'] as LeadField[]) {
        const err = q<HTMLElement>(`[data-err-for=${f}]`);
        const kind = e[f];
        err.hidden = !kind;
        err.textContent = kind ? (err.dataset[kind] ?? '') : '';
        if (kind) fieldOf(f).setAttribute('aria-invalid', 'true');
        else fieldOf(f).removeAttribute('aria-invalid');
      }
    };
    const setFailure = (kind: 'failed' | 'unavailable' | 'limited' | 'invalid' | null): void => {
      failure.hidden = kind === null;
      failureText.textContent = kind ? (failureText.dataset[kind] ?? '') : '';
      label.textContent = (kind && kind !== 'invalid' ? submit.dataset.retry : submit.dataset.idle) ?? '';
    };
    // Кнопка активна и без галочки согласия (P2, A 11.10): клик без согласия показывает ошибку у галочки, а не молчит;
    // блокируется только пока идёт отправка.
    const syncSubmit = (): void => {
      submit.disabled = sending;
    };
    const setSending = (on: boolean): void => {
      sending = on;
      syncSubmit();
      submit.toggleAttribute('data-busy', on);
      form.setAttribute('aria-busy', String(on));
      if (on) label.textContent = submit.dataset.sending ?? '';
    };
    const input = (): LeadInput => ({
      country: country.value as Country, phone: inputs.phone.value, name: inputs.name.value, city: inputs.city.value,
      venue: inputs.venue.value, consent: consent.checked,
    });
    const saveDraft = (): void => {
      try {
        const x = input();
        sessionStorage.setItem(DRAFT, JSON.stringify({ country: x.country, phone: x.phone, name: x.name, city: x.city, venue: x.venue }));
      } catch {
        /* без хранилища введённое живёт до перезагрузки страницы */
      }
    };
    const restoreDraft = (): void => {
      if (Object.values(inputs).some((i) => i.value)) return;
      try {
        const d = JSON.parse(sessionStorage.getItem(DRAFT) ?? 'null') as Record<string, string> | null;
        if (!d) return;
        if (['7', '971', 'other'].includes(d.country)) country.value = d.country;
        for (const k of ['phone', 'name', 'city', 'venue'] as const) if (typeof d[k] === 'string') inputs[k].value = d[k];
      } catch {
        /* черновика нет */
      }
    };
    const placeholder = (): void => {
      inputs.phone.placeholder = inputs.phone.getAttribute(`data-placeholder-${country.value}`) ?? '';
    };

    // Тип бизнеса — скрытым полем, человек его не вводит. С 12.10.2026 его задаёт регион (РФ — сеть, ОАЭ — своё
    // заведение): контракт сессии A — window.__vilaxSegment, затем <html data-segment> (оба A ставит из региона); нет их —
    // тип по версии сайта. Читаем при отправке, а не при загрузке.
    const readSegment = (): LeadSegment =>
      pickSegment(site, (window as unknown as { __vilaxSegment?: unknown }).__vilaxSegment, document.documentElement.dataset.segment);

    // Для аналитики (Analytics.astro, сессия A): форма открыта / заявка принята приёмником. Без счётчика событие никто не слушает.
    const track = (stage: 'open' | 'sent'): void => {
      window.dispatchEvent(new CustomEvent('vilax:lead', { detail: { stage } }));
    };

    const open = (detail: { section?: unknown; calc?: unknown } | null): void => {
      if (!dlg.open) track('open');
      section = sectionOf(detail?.section);
      calc = calcOf(detail?.calc);
      opener = document.activeElement;
      if (!ref) ref = newRequestRef();
      if (!openedAt) openedAt = Date.now();
      if (!dlg.open) show('form');
      restoreDraft();
      placeholder();
      if (!dlg.open) dlg.showModal();
      const first = Object.values(inputs).find((i) => !i.value) ?? inputs.phone;
      first.focus();
    };
    const close = (): void => {
      if (dlg.open) dlg.close();
    };

    (window as unknown as { __vilaxDemoForm?: boolean }).__vilaxDemoForm = true;
    window.addEventListener('vilax:demo', (e) => open((e as CustomEvent).detail ?? null));
    dlg.addEventListener('close', () => {
      if (opener instanceof HTMLElement && opener.isConnected) opener.focus();
    });
    // Клик по затемнению (вне листа) закрывает окно.
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) close();
    });
    for (const b of dlg.querySelectorAll('[data-lead-close]')) b.addEventListener('click', close);

    consent.addEventListener('change', syncSubmit);
    syncSubmit();
    country.addEventListener('change', () => {
      inputs.phone.value = formatPhone(country.value as Country, inputs.phone.value);
      placeholder();
    });
    inputs.phone.addEventListener('input', () => {
      const end = inputs.phone.selectionStart === inputs.phone.value.length;
      const next = formatPhone(country.value as Country, inputs.phone.value);
      if (next !== inputs.phone.value && end) inputs.phone.value = next;
    });
    inputs.phone.addEventListener('blur', () => {
      inputs.phone.value = formatPhone(country.value as Country, inputs.phone.value);
    });
    // Ошибка поля гаснет, как только поле поправили; остальные остаются как были.
    for (const f of ['phone', 'name', 'city', 'venue', 'consent'] as LeadField[]) {
      fieldOf(f).addEventListener(f === 'consent' ? 'change' : 'input', () => {
        if (fieldOf(f).getAttribute('aria-invalid') !== 'true' || checkInput(input())[f]) return;
        fieldOf(f).removeAttribute('aria-invalid');
        const err = q<HTMLElement>(`[data-err-for=${f}]`);
        err.hidden = true;
        err.textContent = '';
      });
    }

    const done = (view: 'done' | 'preview'): void => {
      show(view);
      try {
        sessionStorage.removeItem(DRAFT);
      } catch {
        /* нечего убирать */
      }
      form.reset();
      country.value = dlg.dataset.site === 'ru' ? '7' : '971';
      placeholder();
      syncSubmit();
      ref = '';
      openedAt = 0;
      setFailure(null);
      dlg.querySelector<HTMLElement>(`[data-lead-view=${view}] [data-done-focus]`)?.focus();
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (sending) return;
      const x = input();
      const errors = checkInput(x);
      showErrors(errors);
      const bad = (['phone', 'name', 'city', 'venue', 'consent'] as LeadField[]).find((f) => errors[f]);
      if (bad) {
        setFailure(null);
        fieldOf(bad).focus();
        return;
      }
      if (mode === 'preview') {
        done('preview');
        return;
      }
      const body = leadBody(x, {
        site, segment: readSegment(), section, page: pageOf(location.pathname), utm, calc, consentVersion: dlg.dataset.consentVersion ?? '',
        requestRef: ref || (ref = newRequestRef()), honeypot: honeypot.value, elapsedMs: Date.now() - (openedAt || Date.now() - MIN_FILL_MS),
      });
      setFailure(null);
      setSending(true);
      let outcome = outcomeOf(0, null);
      if (url) {
        const ctl = new AbortController();
        const timer = window.setTimeout(() => ctl.abort(), 15_000);
        try {
          const r = await fetch(url, {
            method: 'POST', mode: 'cors', credentials: 'omit', cache: 'no-store', signal: ctl.signal,
            headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
          });
          let json: unknown = null;
          try {
            json = await r.json();
          } catch {
            /* не JSON — сбой */
          }
          outcome = outcomeOf(r.status, json);
        } catch {
          outcome = { kind: 'failed' };
        } finally {
          window.clearTimeout(timer);
        }
      }
      setSending(false);
      if (outcome.kind === 'ok') {
        track('sent');
        done('done');
        return;
      }
      saveDraft();
      if (outcome.kind === 'invalid' && outcome.field && ['phone', 'name', 'city', 'venue', 'consent'].includes(outcome.field)) {
        showErrors({ [outcome.field]: 'invalid' } as LeadErrors);
        fieldOf(outcome.field as LeadField).focus();
        setFailure('invalid');
        return;
      }
      setFailure(outcome.kind === 'invalid' ? 'failed' : outcome.kind);
    });
  }
</script>

<style>
  .lead {
    --lead-danger: #ff7a7a;
    width: min(520px, calc(100% - 2 * var(--sp-4)));
    max-width: none;
    max-height: calc(100dvh - 2 * var(--sp-5));
    margin: auto;
    padding: 0;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--r-lg);
    background: var(--surface-1);
    color: var(--ink);
    box-shadow: var(--shadow);
    overflow: auto;
    overscroll-behavior: contain;
  }
  :global([data-theme='en']) .lead {
    --lead-danger: #c0262d;
  }
  .lead::backdrop {
    background: rgb(2 8 23 / 0.62);
  }
  .lead__sheet {
    padding: var(--sp-6);
  }
  .lead__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--sp-4);
  }
  .lead__title {
    font-size: var(--fs-headline);
    line-height: 1.2;
    letter-spacing: -0.015em;
    font-weight: 600;
  }
  .lead__close {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin: -10px -10px 0 0;
    border: 0;
    border-radius: var(--r-sm);
    background: transparent;
    color: var(--ink-subtle);
    cursor: pointer;
  }
  .lead__close:hover {
    color: var(--ink);
    background: var(--surface-2);
  }
  .lead__intro {
    margin-top: var(--sp-2);
    color: var(--ink-muted);
    font-size: var(--fs-small);
  }
  .lead__form {
    display: grid;
    gap: var(--sp-4);
    margin-top: var(--sp-5);
  }
  .lead__field {
    display: grid;
    gap: 6px;
  }
  .lead__label {
    font-size: var(--fs-small);
    font-weight: 550;
    color: var(--ink-muted);
  }
  .lead__input {
    width: 100%;
    min-width: 0;
    height: 48px;
    padding: 0 14px;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--r-sm);
    background: var(--canvas);
    color: var(--ink);
    font: 400 16px/1.2 var(--font-sans);
    transition: border-color 0.2s var(--ease-ui);
  }
  .lead__input::placeholder {
    color: var(--ink-faint);
  }
  .lead__input:hover {
    border-color: var(--ink-subtle);
  }
  .lead__input:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 1px;
    border-color: transparent;
  }
  .lead__input[aria-invalid='true'] {
    border-color: var(--lead-danger);
  }
  .lead__phone {
    display: grid;
    grid-template-columns: minmax(96px, auto) 1fr;
    gap: var(--sp-2);
  }
  .lead__country {
    padding-right: 8px;
    cursor: pointer;
  }
  .lead__err {
    color: var(--lead-danger);
    font-size: var(--fs-caption);
    line-height: 1.4;
  }
  .lead__hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .lead__consent {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: var(--sp-3);
    align-items: start;
    font-size: var(--fs-small);
    color: var(--ink-muted);
    cursor: pointer;
  }
  .lead__consent input {
    width: 20px;
    height: 20px;
    margin: 1px 0 0;
    accent-color: var(--accent);
    cursor: pointer;
  }
  .lead__consent input[aria-invalid='true'] {
    outline: 2px solid var(--lead-danger);
    outline-offset: 2px;
  }
  .lead__consent a {
    color: var(--link);
  }
  .lead__failure {
    padding: var(--sp-3) var(--sp-4);
    border: 1px solid var(--lead-danger);
    border-radius: var(--r-sm);
    background: var(--surface-2);
    font-size: var(--fs-small);
    color: var(--ink);
  }
  .lead__contacts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-4);
    margin-top: var(--sp-2);
    color: var(--ink-muted);
  }
  .lead__contacts a {
    color: var(--link);
    font-weight: 550;
  }
  .lead__submit {
    width: 100%;
    height: 48px;
    margin-top: var(--sp-1);
  }
  .lead__submit:disabled {
    cursor: progress;
    opacity: 0.8;
  }
  .lead__spinner {
    display: none;
    width: 16px;
    height: 16px;
    border: 2px solid currentColor;
    border-right-color: transparent;
