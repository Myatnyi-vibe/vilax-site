---
// Экран выбора — только регион (тип бизнеса задан регионом: РФ — сеть, ОАЭ — 1–9 заведений; решение 12.10.2026).
// Приём «Кино»: экран разломлен пополам — слева «Россия и СНГ» в тёмной теме, справа «ОАЭ» в светлой. Знак VILAX на шве.
// Подписи — «русский-first» из ru-словаря (экран один для всех, язык меняет переключатель index.astro).
// Ссылки ведут в /ru/ или /en/; utm дописывает в href клиентский скрипт index.astro.
import { MARK_PATH } from '../brand/logo-paths';
import { ui, type Lang } from '../../i18n';
import { homePath } from '../../lib/site';
import { typo } from '../../lib/typo';

const r = ui('ru').chooser.region;
const tx = (s: string) => typo('ru', s);
const halves: Array<{ v: Lang; d: typeof r.ru }> = [
  { v: 'ru', d: r.ru },
  { v: 'en', d: r.en },
];
---

<section class="rc" aria-labelledby="region-title">
  <header class="rc__head">
    <h1 class="rc__title" id="region-title" data-i18n="region.title">{tx(r.title)}</h1>
  </header>
  <div class="rc__halves">
    {
      halves.map(({ v, d }) => (
        <a class={`rc__half rc__half--${v}`} data-theme={v} data-version={v} href={homePath(v)} hreflang={v}>
          <span class="rc__copy">
            <span class="rc__seg" data-i18n={`region.${v}.segment`}>{tx(d.segment)}</span>
            <span class="rc__label" data-i18n={`region.${v}.card`}>{tx(d.card)}</span>
            <span class="rc__sub" data-i18n={`region.${v}.sub`}>{tx(d.sub)}</span>
            <span class="rc__note" data-i18n={`region.${v}.note`}>{tx(d.note)}</span>
            <span class="rc__go">
              <span class="rc__ring" aria-hidden="true">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 8h10M9 4l4 4-4 4" />
                </svg>
              </span>
              <span data-i18n="region.open">{tx(r.open)}</span>
            </span>
          </span>
        </a>
      ))
    }
  </div>
  <svg class="rc__mark" viewBox="184 170 712 608" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="rc-g" gradientUnits="userSpaceOnUse" x1="184" y1="0" x2="896" y2="0">
        <stop offset="0" stop-color="#18F2DF"></stop>
        <stop offset="1" stop-color="#2297FF"></stop>
      </linearGradient>
    </defs>
    <path fill="url(#rc-g)" d={MARK_PATH}></path>
  </svg>
</section>

<style>
  .rc {
    position: relative;
    min-height: 100dvh;
    background: var(--brand-deep-navy);
    overflow: hidden;
  }
  .rc__head {
    position: absolute;
    z-index: 3;
    top: 0;
    left: 0;
    right: 0;
    height: var(--header-h);
    padding: 0 var(--gutter);
    display: flex;
    align-items: center;
    justify-content: flex-start;
    pointer-events: none;
  }
  /* Вопрос экрана — мелкой строкой сверху слева, на тёмной половине (справа — переключатель языка экрана) */
  .rc__title {
    font-size: var(--fs-caption);
    font-weight: 560;
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #91a0b7;
  }
  .rc__halves {
    display: flex;
    min-height: 100dvh;
  }
  .rc__half {
    position: relative;
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 48px 48px 56px;
    background: var(--canvas);
    color: var(--ink);
    text-decoration: none;
    transition: flex-grow 0.8s var(--ease-out);
    outline-offset: -6px;
  }
  .rc__half--en {
    align-items: flex-end;
    text-align: right;
  }
  .rc__half--en .rc__go {
    flex-direction: row-reverse;
  }
  @media (hover: hover) {
    .rc__halves:hover .rc__half:hover {
      flex-grow: 1.28;
    }
    .rc__halves:has(.rc__half:hover) .rc__half:not(:hover) .rc__copy {
      opacity: 0.5;
    }
  }
  .rc__half:focus-visible {
    flex-grow: 1.28;
  }
  .rc__copy {
    display: flex;
    flex-direction: column;
    align-items: inherit;
    transition: opacity 0.5s var(--ease-out);
  }
  /* Для кого версия: РФ — сети, ОАЭ — 1–9 своих заведений (тип бизнеса задан регионом) */
  .rc__seg {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    min-height: 32px;
    margin-bottom: 16px;
    padding: 0 14px;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    border-radius: var(--r-pill);
    color: var(--accent);
    font-size: var(--fs-caption);
    font-weight: 560;
    letter-spacing: 0.01em;
  }
  .rc__label {
    font-size: clamp(2.75rem, 7vw, 6.5rem);
    line-height: 0.95;
    font-weight: var(--display-weight);
    letter-spacing: -0.045em;
  }
  .rc__sub {
    margin-top: 12px;
    font-size: clamp(1rem, 1.3vw, 1.1875rem);
    color: var(--ink-muted);
  }
  .rc__note {
    margin-top: 6px;
    font-size: var(--fs-small);
    color: var(--ink-subtle);
  }
  .rc__go {
    margin-top: 28px;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-size: 0.9375rem;
    font-weight: 550;
  }
  .rc__ring {
    width: 56px;
    height: 56px;
    border-radius: var(--r-pill);
    border: 1px solid var(--hairline-strong);
    display: grid;
    place-items: center;
    transition:
      background-color 0.3s var(--ease-ui),
      border-color 0.3s var(--ease-ui),
      color 0.3s var(--ease-ui),
      transform 0.5s var(--ease-out);
  }
  .rc__ring svg {
    width: 16px;
    height: 16px;
  }
  .rc__half:hover .rc__ring,
  .rc__half:focus-visible .rc__ring {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
    transform: translateX(4px);
  }
  .rc__mark {
    position: absolute;
    left: 50%;
    top: 46%;
    width: min(44vw, 620px);
    height: auto;
    aspect-ratio: 712 / 608;
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 2;
  }
  @media (prefers-reduced-motion: reduce) {
    .rc__half {
      transition: none;
    }
    .rc__halves:hover .rc__half:hover,
    .rc__half:focus-visible {
      flex-grow: 1;
    }
    .rc__half:hover .rc__ring,
    .rc__half:focus-visible .rc__ring {
      transform: none;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .rc__mark {
      animation: rc-mark 1.2s var(--ease-out) both;
    }
    .rc__copy {
      animation: rc-copy 0.9s var(--ease-out) 0.3s both;
    }
  }
  @keyframes rc-mark {
    from {
      opacity: 0;
      transform: translate(-50%, -46%) scale(0.94);
    }
  }
  @keyframes rc-copy {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  /* Телефон: половины одна над другой и всегда равной высоты (шов ровно посередине, на нём знак).
     РФ — текст сверху под вопросом экрана, ОАЭ — снизу; у шва место под знак, чтобы он не наезжал на «Открыть». */
  @media (max-width: 767px) {
    .rc__halves {
      display: grid;
      grid-template-rows: 1fr 1fr;
    }
    .rc__half {
      min-height: 50vh;
      padding: 24px 20px 28px;
    }
    .rc__half--ru {
      justify-content: flex-start;
      padding-top: calc(var(--header-h) + 36px);
      padding-bottom: calc(24vw + 16px);
    }
    .rc__half--en {
      align-items: flex-start;
      text-align: left;
      padding-top: calc(24vw + 16px);
    }
    .rc__go {
      margin-top: 20px;
    }
    .rc__half--en .rc__go {
      flex-direction: row;
    }
    .rc__label {
      font-size: 2.75rem;
    }
    .rc__ring {
      width: 48px;
      height: 48px;
    }
    .rc__mark {
      top: 50%;
      width: 52vw;
    }
  }
</style>
