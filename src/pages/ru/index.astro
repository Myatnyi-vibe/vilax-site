---
import Version from '../../layouts/Version.astro';
import { homePath } from '../../lib/site';
import Home from '../../components/home/Home.astro';
import { ui } from '../../i18n';
import { organizationLd, softwareLd } from '../../lib/seo';

const t = ui('ru');
---

<Version
  lang="ru"
  title={t.meta.title}
  description={t.meta.description}
  path={homePath('ru')}
  alternates={{ ru: homePath('ru'), en: homePath('en') }}
  overHero
  jsonLd={[organizationLd(), softwareLd('ru', t.meta.description)]}
>
  <Home lang="ru" />
</Version>
